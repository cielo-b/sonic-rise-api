NODE_ENV=development
PORT=4000

# Matches the postgres service in docker/docker-compose.yml
DATABASE_URL="postgresql://sonicrise:sonicrise@localhost:5432/sonicrise"

JWT_SECRET="your-strong-secret-here"
JWT_EXPIRES_IN="7d"

# Web app origin(s), comma-separated. Also used for email links when BASE_DOMAIN is unset.
FRONTEND_URL="http://localhost:3000"

# ── Multi-studio ──────────────────────────────────────────────────────────
# Each studio is served at <slug>.<BASE_DOMAIN>, e.g. sonicrise.studios.rw.
# Leave BASE_DOMAIN empty for a single-studio deployment and set DEFAULT_STUDIO.
BASE_DOMAIN=
SITE_SCHEME=https
DEFAULT_STUDIO=

# Encrypts payment provider tokens at rest (32+ random characters).
# Changing it makes stored tokens unreadable.
APP_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# Object storage (MinIO / S3). Matches docker/docker-compose.yml for local dev.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=sonicrise
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=sonicrise
# Private bucket for client deliverables (signed download links only).
MINIO_PRIVATE_BUCKET=sonicrise-private
MINIO_PUBLIC_URL=http://localhost:9000

# SMTP. For local dev, docker-compose runs Mailpit (inbox at http://localhost:8025).
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=dev
EMAIL_PASSWORD=dev
EMAIL_FROM="no-reply@sonicrise.rw"

# Optional: password for accounts created by `npm run seed` (see src/database/seed.ts).
# If unset, each new account gets a random password printed to the console.
# SEED_PASSWORD=
